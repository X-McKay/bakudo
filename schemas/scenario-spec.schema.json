{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakudo.ai/schemas/scenario-spec.schema.json",
  "title": "ScenarioSpec",
  "description": "A versioned, reproducible, self-contained benchmark unit (experiment substrate design doc section 5).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "mission", "environment", "budgets", "hidden", "expect"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "bakudo.ai/v1alpha1" },
    "kind": { "const": "ScenarioSpec" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "family", "difficulty", "tags", "partition", "canary", "provenance"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "family": { "enum": ["debugging", "no-change", "adversarial-context", "safety"] },
        "difficulty": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "partition": { "enum": ["dev", "validation", "holdout"] },
        "twinOf": { "type": ["string", "null"], "default": null },
        "canary": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "required": ["createdBy", "createdAt", "sourceType", "eligibleForPromotion"],
          "additionalProperties": false,
          "properties": {
            "createdBy": { "type": "string", "minLength": 1 },
            "createdAt": { "type": "string" },
            "sourceType": { "type": "string", "minLength": 1 },
            "eligibleForPromotion": { "type": "boolean" }
          }
        }
      }
    },
    "mission": {
      "type": "object",
      "required": ["type", "title", "description", "acceptanceCriteria", "constraints"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "object", "additionalProperties": true }
      }
    },
    "environment": {
      "type": "object",
      "required": ["profile", "network"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "network": { "enum": ["none", "scoped"] }
      }
    },
    "budgets": {
      "type": "object",
      "description": "Combined with the agent spec's budget via min() — tighten-only.",
      "additionalProperties": false,
      "properties": {
        "wallSeconds": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "toolCalls": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "tokens": { "type": ["integer", "null"], "minimum": 1, "default": null }
      }
    },
    "hidden": {
      "type": "object",
      "description": "SWE-bench-compatible test semantics; never materialized into the agent's workspace.",
      "required": ["failToPass", "passToPass", "testCommand", "wrongFixProbes", "expectedFiles"],
      "additionalProperties": false,
      "properties": {
        "failToPass": { "type": "array", "items": { "type": "string" } },
        "passToPass": { "type": "array", "items": { "type": "string" } },
        "testCommand": { "type": "string", "minLength": 1 },
        "wrongFixProbes": { "type": "array", "items": { "type": "string" } },
        "expectedFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expect": {
      "type": "object",
      "required": ["status", "changesPaths", "maxChangedFiles", "forbidsDeniedCommands", "testPathsImmutable"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "changesPaths": { "type": "array", "items": { "type": "string" } },
        "maxChangedFiles": { "type": "integer", "minimum": 0 },
        "forbidsDeniedCommands": { "type": "boolean" },
        "testPathsImmutable": { "type": "boolean" }
      }
    }
  }
}
