# Copy to .env and adjust. The control plane reads these; secrets are never
# placed in AgentSpecs (spec sections 7.3, 19).

# Repo-scoped kubectl: after `make kubeconfig`, all kubectl activity from this
# project reads/writes ONLY .kube/config (context "bakudo") — it can never
# switch contexts on or mutate the host's ~/.kube/config. $PWD expands when
# .env is sourced from the repo root (set -a; . ./.env; set +a).
KUBECONFIG="$PWD/.kube/config"

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Postgres ledger + durable semantic memory (leave unset to use the in-memory
# ledger and store)
BAKUDO_POSTGRES_DSN=postgresql://bakudo:bakudo@localhost:5432/bakudo

# Neo4j graph memory. When NEO4J_URI is set the worker also mirrors accepted
# memory writes into the graph (NEO4J_PASSWORD is then required).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bakudo-dev-password

# vLLM gateway (OpenAI-compatible). The worker reaches this only via the abox
# "vllm-gateway" network bundle.
VLLM_BASE_URL=http://localhost:4000/v1
VLLM_API_KEY=not-needed

# Per-provider-ref overrides resolve as BAKUDO_VLLM_<REF> (ref upper-cased,
# non-alphanumerics -> _). Example for baseUrlRef "vllm/qwen-coder":
# BAKUDO_VLLM_VLLM_QWEN_CODER=http://localhost:4000/v1

# Control API bearer token. When unset, API auth is disabled (dev only); set it
# in any shared environment so mutating routes require Authorization: Bearer ...
# BAKUDO_API_TOKEN=change-me

# Sandbox selection fails CLOSED: you must choose explicitly.
#   BAKUDO_SANDBOX=abox   -> run worker agents in abox microVMs (production)
#   BAKUDO_SANDBOX=local  -> in-process local sandbox (NOT isolated; dev only,
#                            and additionally requires BAKUDO_ENV=dev)
BAKUDO_SANDBOX=abox
# BAKUDO_ENV=dev
# BAKUDO_OFFLINE=1    # bypass the model entirely (dry-run)

# Curriculum signal collector (RepoObserverWorkflow / collect_signals). Set any
# subset; an unset source is skipped. With none set, no objectives are
# auto-generated (the observer stays quiet rather than guessing).
# BAKUDO_REPO_PATH=/path/to/checkout         # scan TODO/FIXME in a worktree
# BAKUDO_COVERAGE_XML=/path/to/coverage.xml  # Cobertura coverage report
# BAKUDO_JUNIT_XML=/path/to/results.xml      # JUnit test results
# GITHUB_TOKEN=ghp_...                       # enables the GitHub issues collector
